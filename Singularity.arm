BootStrap: docker
From: arm64v8/ubuntu:22.04


%files
    pyproject.toml /opt/rt-run/pyproject.toml
    README.md /opt/rt-run/README.md
    LICENSE /opt/rt-run/LICENSE
    src/rt_run.py /opt/rt-run/src/rt_run.py

%arguments
    # `--build-arg MARCH=native` (or armv8.2-a, ...) builds the tools whose
    # upstreams use -march -- PRESTO, iqrm_apollo, riptide, RFIClean -- for
    # that CPU. Off by default: the published images run on any machine of
    # the architecture, and CI refuses to publish anything else. See "Build
    # flags" in the README.
    MARCH=none

%post
    echo "Installing packages needed for multiple programs"
    apt-get -y update
    export DEBIAN_FRONTEND=noninteractive 
    MARCH="{{ MARCH }}"
    case "$MARCH" in ""|none) MARCH=none; MARCH_FLAG="" ;; *) MARCH_FLAG="-march=$MARCH" ;; esac
    echo "Build-march $MARCH" >> "$SINGULARITY_LABELS"
    apt-get -y install build-essential cmake git htop software-properties-common wget # need these to build packages
     
    apt-add-repository multiverse # add the multiverse repository (where pgplot5 lives)
    apt-get -y install pgplot5 
    export PGPLOT_DIR=/usr/lib/pgplot5

    # apt-get -y install python3-numpy python-is-python3 python3-pip python3-scipy # use conda instead
    apt-get -y install libfftw3-dev libfftw3-bin libcfitsio-dev # We need these packages for multiple programs

    # use conda so everthing is compatiable with the cuda-10-2 container
    wget https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-aarch64.sh -O ~/miniconda.sh -q
    bash ~/miniconda.sh -b -p /usr/local/miniconda
    rm ~/miniconda.sh
    eval "$(/usr/local/miniconda/bin/conda shell.bash hook)"
    conda init
    conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main
    conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r
    conda create -y --name RT python=3.10
    conda activate RT

    # As described in https://github.com/hpcng/singularity/issues/5075#issuecomment-594391772
    echo "## Activate RT environment" >> /.singularity_bash
    echo "source /usr/local/miniconda/etc/profile.d/conda.sh" >> /.singularity_bash
    echo "conda activate RT" >> /.singularity_bash

    pip install --no-cache-dir numpy # make sure pip numpy get installed to avoid presto python error

    echo "Installing iqrm_apollo"
    cd ~
    apt-get -y install libboost-all-dev
    apt-get -y clean # boost-all-dev's archives are large; this disk only has ~25G free for the whole build
    git clone https://gitlab.com/kmrajwade/iqrm_apollo.git
    cd iqrm_apollo
    mkdir build; cd build
    # Its cmake/compiler_settings.cmake forces -march=native with set(), which
    # no flag can override; that tied the binary to whatever CPU built the
    # image. Swap in MARCH's choice, or nothing, and fail if the sed stops
    # matching rather than silently go back to native.
    sed -i "s/ -march=native/${MARCH_FLAG:+ $MARCH_FLAG}/" ../cmake/compiler_settings.cmake
    if [ -z "$MARCH_FLAG" ]; then
        ! grep -q -- '-march' ../cmake/compiler_settings.cmake || { echo "iqrm_apollo still has -march" >&2; exit 1; }
    else
        grep -qF -- "$MARCH_FLAG" ../cmake/compiler_settings.cmake || { echo "iqrm_apollo didn't take $MARCH_FLAG" >&2; exit 1; }
    fi
    cmake -DBOOST_ROOT=/ ../
    make -j
    cp iqrm_apollo/iqrm_apollo_cli /usr/local/bin/
    echo "iqrm_apollo Built at commit $(git rev-parse HEAD) which was on $(git log -1 --format=%cd)" >> "$SINGULARITY_LABELS"
    cd ~ && rm -rf iqrm_apollo

    echo "Installing juyterlab"
    conda install -y -c conda-forge jupyterlab
    conda clean -y --all # conda-forge's jupyterlab pulls a large dependency tree into the package cache
    echo "Jupiterlab Built from conda" >> "$SINGULARITY_LABELS"

    echo "Installing Tempo"
    cd /usr/local #put file here so we can access them later
    apt-get -y install csh autoconf gfortran
    git clone https://git.code.sf.net/p/tempo/tempo
    cd tempo
    ./prepare
    ./configure
    sed -i 's/real\*10 frb/real\*8 frb/' src/bnrydds.f # 10 bit variables are not supported
    make
    make install
    export TEMPO=$PWD # Presto need to know this
    echo "Tempo Built at commit $(git rev-parse HEAD) which was on $(git log -1 --format=%cd)" >> "$SINGULARITY_LABELS"

    echo "Installing PRESTO"
    cd /usr/local/
    # PRESTO's `make prep && make` path needs erfa.h and offers no fallback, so
    # it stopped building once upstream moved to meson. meson pulls erfa in as a
    # subproject when the system has none. Singularity.cpu already made this
    # switch; this is the same change, targeting the conda env this recipe now
    # builds against instead of /usr/local.
    # liberfa-dev: without a system ERFA, meson downloads and builds one.
    apt-get -y install libglib2.0-dev libpng-dev libx11-dev mpich libgsl-dev liberfa-dev
    apt-get -y clean
    conda install -y meson meson-python ninja
    conda clean -y --all
    git clone https://github.com/scottransom/presto.git
    cd presto
    export PRESTO=$PWD
    # PRESTO's own default is -O2 -g, which its INSTALL.md measured as fast as
    # -O3. -march, when MARCH asks for it, is its documented speed-up for
    # accelsearch.
    meson setup build --prefix=$CONDA_PREFIX ${MARCH_FLAG:+-Dc_args=$MARCH_FLAG}
    # meson installs libraries to $prefix/lib/<triplet>, and check_meson_build.py
    # refuses to proceed unless that directory is on LIBRARY_PATH. Derive the
    # triplet rather than hardcoding it, so this works on every architecture.
    TRIPLET=$(gcc -dumpmachine)
    export LIBRARY_PATH=$CONDA_PREFIX/lib/$TRIPLET:$LIBRARY_PATH
    export LD_LIBRARY_PATH=$CONDA_PREFIX/lib/$TRIPLET:$LD_LIBRARY_PATH
    python check_meson_build.py
    meson compile -C build
    meson install -C build
    cd python
    pip install --no-cache-dir --config-settings=builddir=build .
    cd "$PRESTO"
    echo "PRESTO Built at commit $(git rev-parse HEAD) which was on $(git log -1 --format=%cd)" >> "$SINGULARITY_LABELS"

    # PRESTO makes polycos (prepfold -timing) with tempo2 now, not TEMPO.
    # Installed after PRESTO is built, so PRESTO's meson can't pick up the
    # conda-forge fftw, cfitsio and gsl it brings. Its activation script sets
    # TEMPO2, which %environment's `activate RT` runs.
    echo "Installing tempo2"
    conda install -y -c conda-forge tempo2
    echo "tempo2 $(conda list '^tempo2$' | awk '$1 == "tempo2" {print $2}') from conda-forge" >> "$SINGULARITY_LABELS"

    echo "Installing psrcat"
    cd ~
    wget https://www.atnf.csiro.au/people/pulsar/psrcat/downloads/psrcat_pkg.tar.gz
    tar xf psrcat_pkg.tar.gz 
    cd psrcat_tar
    # upstream replaced the csh `makeit` script with a Makefile; running the old
    # one under tcsh now fails with "Illegal variable name". Same as the cpu recipe.
    make psrcat
    mv psrcat /usr/local/bin
    mv *.db /usr/local
    echo "Built psrcat"
    cd ~ && rm -rf psrcat_tar
    echo "psrcat no version control"
    
    echo "Installing pysigproc"
    cd ~
    git clone https://github.com/devanshkv/pysigproc.git
    cd pysigproc
    pip install --no-cache-dir .
    echo "pysigproc Built at commit $(git rev-parse HEAD) which was on $(git log -1 --format=%cd)" >> "$SINGULARITY_LABELS"
    cd ~ && rm -rf pysigproc

    echo "Installing rficlean"
    cd ~
    # git clone https://github.com/josephwkania/RFIClean.git
    git clone https://github.com/ymaan4/RFIClean.git 
    cd RFIClean
    # RFIClean declares its sigproc globals in a header without `extern`. GCC 9
    # accepted that because -fcommon was the default; GCC 10 onwards defaults to
    # -fno-common, so every translation unit emits its own definition and the
    # link fails with "multiple definition of". This is a compiler-version
    # issue, not an architecture one -- it appears on any base with GCC >= 10.
    # Overriding CFLAGS replaces the Makefile's value, so -Iinclude has to be
    # repeated or the compile cannot find the headers. -march=native is dropped
    # deliberately: it bakes the build machine's ISA into the binary, which is
    # wrong for a container meant to run on other hardware.
    # MARCH, when given, adds a -march of the builder's choosing.
    make CFLAGS="-Iinclude -Wno-unused-result -O3 -fcommon $MARCH_FLAG"
    # MYBIN is its install directory, hard-coded to the author's home.
    make install MYBIN=/usr/local/bin
    echo "RFICLean Built at commit $(git rev-parse HEAD) which was on $(git log -1 --format=%cd)" >> "$SINGULARITY_LABELS"
    cd ~ && rm -rf RFIClean 

    echo "Installing riptide"
    # PyPI has only its source, and its setup.py compiles with -march=native,
    # which no CFLAGS can override. Patch in MARCH's choice, or nothing.
    mkdir /tmp/riptide
    pip download --no-cache-dir --no-deps --no-binary riptide-ffa --dest /tmp/riptide riptide-ffa
    tar xf /tmp/riptide/riptide*ffa-*.tar.gz -C /tmp/riptide
    cd /tmp/riptide/riptide*ffa-*/
    if [ -z "$MARCH_FLAG" ]; then
        sed -i 's/, *"-march=native"//' setup.py
        ! grep -q -- '-march' setup.py || { echo "riptide still has -march" >&2; exit 1; }
    else
        sed -i "s/\"-march=native\"/\"$MARCH_FLAG\"/" setup.py
        grep -qF -- "\"$MARCH_FLAG\"" setup.py || { echo "riptide didn't take $MARCH_FLAG" >&2; exit 1; }
    fi
    pip install --no-cache-dir .
    echo "riptide-ffa $(basename "$PWD" | sed 's/^riptide.ffa-//') from PyPI" >> "$SINGULARITY_LABELS"
    cd ~ && rm -rf /tmp/riptide
 
    echo "Installing sigproc"
    cd ~
    git clone https://github.com/SixByNine/sigproc.git
    cd sigproc
    ./bootstrap
    ./configure --prefix=/usr/local/
    grep -q '^CFLAGS = .*-O2' Makefile || { echo "sigproc lost its -O2" >&2; exit 1; }
    make
    make install
    echo "sigproc Built at commit $(git rev-parse HEAD) which was on $(git log -1 --format=%cd)" >> "$SINGULARITY_LABELS"
    cd ~ && rm -rf sigproc
    
    echo "Installing YAPP"
    cd ~
    apt-get -y install libhdf5-dev
    mkdir -p /usr/local/hdf5
    ln -s /usr/include/hdf5/serial /usr/local/hdf5/include
    mkdir -p /usr/local/hdf5
    ln -s /usr/lib/$(gcc -dumpmachine)/hdf5/serial/lib /usr/local/hdf5/lib # multiarch path, derived so it follows the base image's architecture
    git clone https://github.com/jayanthc/yapp.git
    cd yapp 
    make HDF5=yes
    make install
    echo "YAPP Built at commit $(git rev-parse HEAD) which was on $(git log -1 --format=%cd)" >> "$SINGULARITY_LABELS"
    cd ~ && rm -rf yapp    

    echo "Installing your"
    cd ~
    git clone https://github.com/thepetabyteproject/your.git
    cd your
    pip install --no-cache-dir .
    echo "your built at commit $(git rev-parse HEAD) which was on $(git log -1 --format=%cd)" >> "$SINGULARITY_LABELS"
    cd ~ && rm -rf your

    echo "Installing jess"
    cd ~
    git clone https://github.com/josephwkania/jess.git
    cd jess
    pip install --no-cache-dir .
    echo "jess Built at commit $(git rev-parse HEAD) which was on $(git log -1 --format=%cd)"  >> "$SINGULARITY_LABELS"
    cd ~ && rm -rf jess

    echo "Installing will"
    cd ~
    git clone https://github.com/josephwkania/will.git
    cd will
    pip install --no-cache-dir .
    echo "will Built at commit $(git rev-parse HEAD) which was on $(git log -1 --format=%cd)"  >> "$SINGULARITY_LABELS"
    cd ~ && rm -rf will

    # This wants to remove libboost, which we need
    #apt-get -y purge cmake build-essential git wget # remove build time dependencies
    #apt-get -y autoremove 
    apt-get -y clean # /var/cache/apt/archives is not emptied on its own,
    conda clean --all

    # rt-run, the host-side launcher, which %files copied in -- from paths
    # relative to where `singularity build` runs, so build from the repo's
    # root. Here so that `singularity run --app install IMAGE` works from the
    # image alone, and so that `rt-run update` can take the launcher matching
    # the image it pulled.
    /usr/local/miniconda/envs/RT/bin/pip install --no-cache-dir /opt/rt-run
    rm -rf /opt/rt-run
    # One version for the whole repo, rt-run's __version__ -- the same number
    # PyPI has -- written here rather than in %labels so the four recipes
    # cannot drift apart. The build date is the day this ran, not a day
    # someone typed in.
    RT_VERSION=$(/usr/local/miniconda/envs/RT/bin/rt-run --version | cut -d' ' -f2)
    echo "Version v$RT_VERSION" >> "$SINGULARITY_LABELS"
    echo "Build-date $(date -u +%d-%b-%Y)" >> "$SINGULARITY_LABELS"
    # The GHCR tag this build is published as: what `rt-run install --from`
    # records, and what `rt-run update` pulls.
    echo "RT_TAG arm" >> "$SINGULARITY_LABELS"

    # Nothing reads these after the build. pip's wheel cache is the big one --
    # 206 MB here, and wheels are already compressed, so it costs full size in
    # the image and on every pull.
    rm -rf /root/.cache/pip
    rm -rf /var/lib/apt/lists/*
    rm -rf /usr/local/presto/.git /usr/local/presto/build /usr/local/presto/python/build
    rm -rf /usr/local/tempo/.git
    find /usr/local/tempo/src -name '*.o' -delete 2>/dev/null || true

    echo "Done building!"


%environment
    # For conda
    action="${0##*/}"
    if [ "$action" = "shell" ]; then
        if [ "${SINGULARITY_SHELL:-}" = "/bin/bash" ]; then
            set -- --noprofile --init-file /.singularity_bash
        elif test -z "${SINGULARITY_SHELL:-}"; then
            export SINGULARITY_SHELL=/bin/bash
            set -- --noprofile --init-file /.singularity_bash
        fi
    fi

    source /usr/local/miniconda/bin/activate RT # sets up conda so we can access outside the container

    export PGPLOT_DIR=/usr/lib/pgplot5
    export TEMPO=/usr/local/tempo
    export PRESTO=/usr/local/presto
    export LD_LIBRARY_PATH=/usr/local/miniconda/envs/RT/lib/aarch64-linux-gnu:$LD_LIBRARY_PATH
    export PSRCAT_FILE=/usr/local/psrcat.db


%runscript
    # `singularity run IMAGE CMD [ARGS...]` runs CMD, found on the PATH that
    # %environment sets up; with no arguments it opens a shell.
    if [ "$#" -gt 0 ]; then
        exec "$@"
    fi
    exec /bin/bash --noprofile --init-file /.singularity_bash


%help
    This container has CPU w/arm64 (aarch64) software to search for radio transients.
        
    Contains the following programs:
    htop          https://htop.dev/
    iqrm_apollo   https://gitlab.com/kmrajwade/iqrm_apollo
    jess           https://github.com/josephwkania/jess
    jupyterlab    https://jupyter.org/
    PRESTO        https://www.cv.nrao.edu/~sransom/presto/
    psrcat        https://www.atnf.csiro.au/people/pulsar/psrcat/download.html
    pysigproc     https://github.com/devanshkv/pysigproc
    riptide       https://github.com/v-morello/riptide
    sigproc       https://github.com/SixByNine/sigproc
    Tempo         http://tempo.sourceforge.net/ - modified to compile on arm
    tempo2        https://bitbucket.org/psrsoft/tempo2
    RFIClean      https://github.com/ymaan4/RFIClean
    will           https://github.com/josephwkania/will
    YAPP          https://github.com/jayanthc/yapp
    your          https://github.com/thepetabyteproject/your


%labels
    Author Joseph W Kania


%apphelp install
    Put this image's tools on your PATH, on the host:

        singularity run --app install IMAGE.sif [--bin-dir DIR]

    Then add the directory it names to PATH. See `rt-run --help`.

%apprun install
    exec /usr/local/miniconda/envs/RT/bin/rt-run install "$@"
